# ==========================================================
# 环境变量模板
# 复制本文件为 .env 并填写真实密钥: cp .env.example .env
# ==========================================================

# 智谱AI API 密钥（必填，前往 https://open.bigmodel.cn 获取）
ZHIPUAI_API_KEY=your_api_key_here

# ---------- 模型配置（可选） ----------
ZHIPUAI_LLM_MODEL=glm-5.3
ZHIPUAI_EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=2048
